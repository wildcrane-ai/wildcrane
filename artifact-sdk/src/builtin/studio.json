{
  "name": "studio",
  "title": { "en": "Studio", "zh": "工作台" },
  "types": ["studio"],
  "schema": {
    "type": "object",
    "required": ["rounds", "land", "scheduled"],
    "properties": {
      "rounds": {
        "type": "array",
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["agent", "title"], "properties": { "agent": { "type": "string" }, "title": { "type": "object", "required": ["en"] } } }
        }
      },
      "land": { "type": "array", "items": { "type": "object", "required": ["agent", "title"] } },
      "scheduled": { "type": "array", "items": { "type": "object", "required": ["agent", "title"] } }
    }
  }
}
